# ==============================================================================
# TRẤN BIÊN KẾT NỐI - MẪU CẤU HÌNH MÔI TRƯỜNG (Giai đoạn 2)
#
# File này được commit, KHÔNG chứa giá trị bí mật. Cách dùng:
#   - Supabase cloud: sao chép thành app/.env       (cp .env.example .env)
#   - Supabase local: sao chép thành app/.env.local (cp .env.example .env.local)
# Thứ tự ưu tiên khi nạp: biến có sẵn (Vercel env, CI) > .env.local > .env.
# Nghĩa là nếu máy còn app/.env.local thì giá trị trong đó thắng app/.env.
# Cả .env và .env.local đều bị .gitignore chặn, không commit.
#
# Lấy giá trị Supabase cloud ở Dashboard của project:
#   - Connect (nút trên cùng) -> chuỗi kết nối Transaction pooler / Session pooler
#   - Project Settings -> API Keys -> Publishable key và Secret key
# Sinh chuỗi ngẫu nhiên: openssl rand -hex 32
# ==============================================================================

# --- Cơ sở dữ liệu (PostgreSQL 15+ có PostGIS) --------------------------------
# API (server, Vercel): Transaction pooler, port 6543.
#   Cloud: postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
#   Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Script seed / demo:reset / db:verify / migration: Session pooler, port 5432
# (kết nối trực tiếp db.<PROJECT_REF>.supabase.co chỉ có IPv6, nhiều mạng không vào được).
#   Cloud: postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#   Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_DIRECT=

# --- Supabase project ---------------------------------------------------------
#   Cloud: https://<PROJECT_REF>.supabase.co     Local: http://127.0.0.1:54321
SUPABASE_URL=
# Publishable key (sb_publishable_...) hoặc khoá cũ "anon". Dùng gọi Supabase Auth khi cán bộ/TNV đăng nhập.
SUPABASE_ANON_KEY=
# Biến cho giao diện (Vite đưa vào bundle trình duyệt): chỉ để khoá công khai ở đây.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# CHỈ SERVER/SCRIPT: Secret key (sb_secret_...) hoặc khoá cũ "service_role". Không bao giờ đặt tiền tố VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Bí mật do ứng dụng tự quản (tự sinh, không lấy từ Supabase) ---------------
# Khoá ký token phiên cán bộ/TNV do API cấp sau khi Supabase Auth xác nhận mật khẩu (HS256, >= 32 ký tự).
SUPABASE_JWT_SECRET=
# Khoá ký JWT 30 ngày của người dân sau OTP (>= 32 ký tự).
CITIZEN_JWT_SECRET=
# Pepper khi băm secretCode, ownerToken, ip_hash (>= 16 ký tự). Đổi giá trị này sẽ làm mã cũ hết khớp.
OWNER_KEY_PEPPER=
# Bảo vệ endpoint Vercel Cron /api/v1/cron/* (>= 16 ký tự).
CRON_SECRET=

# --- Dịch vụ ngoài (đang MÔ PHỎNG, UI có nhãn "Mô phỏng") -----------------------
# mock: OTP luôn là 123456, SMS giả lập. real: chỉ dùng khi chủ dự án đồng ý tích hợp thật.
OTP_PROVIDER=mock
SMS_PROVIDER=mock
ALLOW_MOCK_OTP=true

# --- Demo & vận hành ------------------------------------------------------------
# true: cho phép demo:reset / demo:clock. demo:reset XOÁ dữ liệu phát sinh rồi nạp lại 64 hồ sơ mẫu.
DEMO_MODE=true

# --- Giao diện ------------------------------------------------------------------
# local: chạy offline với localStorage + mock.json (Giai đoạn 1). api: gọi API Hono + Supabase.
VITE_DATA_SOURCE=api

# --- Script seed ----------------------------------------------------------------
# Mật khẩu ban đầu của tài khoản cán bộ/TNV mẫu khi chạy `npm run seed` (>= 10 ký tự, tự đặt riêng).
SEED_STAFF_PASSWORD=
