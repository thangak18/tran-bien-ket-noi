# ==============================================================================
# TRẤN BIÊN KẾT NỐI - GIAI ĐOẠN 2 ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env.local để sử dụng trên máy local (không commit .env.local)
# ==============================================================================

# Database Connection (PostgreSQL 15+ & PostGIS)
# Khi dùng Supabase Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Khi dùng Supabase Cloud: chuỗi kết nối Transaction Pooler (port 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct Database Connection (dùng riêng cho chạy Drizzle migrations)
# Khi dùng Supabase Cloud: chuỗi kết nối Session Mode / Direct (port 5432)
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Project Configuration
# Supabase Local: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Client Environment Variables (tiền tố VITE_)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER ONLY - Tuyệt đối không để lộ phía client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Staff JWT Secret (SERVER ONLY - dùng giải mã và xác thực token cán bộ/TNV)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Citizen Authentication & Privacy Protection
# Chuỗi ngẫu nhiên bí mật ≥ 32 bytes dùng để ký JWT 30 ngày cho người dân
CITIZEN_JWT_SECRET=your-random-32-byte-secret-for-citizen-jwt

# Pepper cho mã hoá băm SHA-256 (secretCode, ownerToken, ip_hash)
OWNER_KEY_PEPPER=your-random-pepper-string-for-hash-salting

# Service Providers Configuration
# mock: Chấp nhận OTP 123456, SMS giả lập | real: Kết nối dịch vụ bên thứ ba
OTP_PROVIDER=mock
SMS_PROVIDER=mock

# Cho phép chạy OTP mock ở môi trường production (mặc định false để đảm bảo an toàn)
ALLOW_MOCK_OTP=true

# Demo & Operations Mode
# true: Cho phép thực thi script demo:reset và demo:clock
DEMO_MODE=true

# Secret Token bảo vệ endpoint Vercel Cron (/api/v1/cron/*)
CRON_SECRET=your-random-cron-secret-token

# Frontend Data Source Mode
# local: Chạy offline hoàn toàn với localStorage và mock.json (Giai đoạn 1)
# api: Kết nối với REST API backend và Supabase DB (Giai đoạn 2)
VITE_DATA_SOURCE=local

# Seed Configuration (Chỉ dùng khi chạy npm run db:seed)
SEED_STAFF_PASSWORD=TranBien@2026!
